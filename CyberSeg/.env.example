# PostgreSQL and API
POSTGRES_DB=cyberseg
POSTGRES_USER=cyberseg
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://cyberseg:change_this_local_password@postgres:5432/cyberseg?schema=public
CYBERSEG_ENGINE_TOKEN=replace_with_a_long_random_local_token

# IDS engine: capture is deliberately off until an operator enables it.
CYBERSEG_API_URL=http://127.0.0.1:8780
# This grants the container permission to capture from the configured local
# interface. JARVIS still needs a separate confirmed start request.
CYBERSEG_CAPTURE_ALLOWED=false
CYBERSEG_INTERFACE=
CYBERSEG_WINDOW_SECONDS=180
CYBERSEG_CONTAMINATION=0.02
