# Copy this file to .env and set the values you need.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# When AI_PROVIDER=openai, an explicit visual-analysis command can send only
# that requested in-memory capture to the same provider. Local/Ollama mode
# keeps the integrated visual context on this computer.

# Offline/local AI with Ollama (no API key needed after the model is downloaded).
# AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# Voice input configuration
STT_LANGUAGE=es-ES
# The integrated microphone detected on this PC is index 1. Leave blank to use
# whichever Windows device is currently set as default.
MICROPHONE_INDEX=
LISTEN_TIMEOUT=8
PHRASE_TIME_LIMIT=20
AMBIENT_NOISE_DURATION=0.5

# Conversation configuration
MAX_CONVERSATION_TURNS=8
TTS_RATE=185
TTS_VOLUME=1.0
TTS_VOICE_HINT=
TTS_ENABLED=true
# "piper" uses the free local Spanish male DaveFX voice. It downloads once,
# then works offline. Use "sapi" to return to the installed Windows voice.
TTS_PROVIDER=piper
TTS_PIPER_MODEL_DIR=data/voices/davefx

# Chrome profile used for normal account logins. "last_used" selects the most
# recently used local Chrome profile, preserving its existing signed-in session.
# You can also use Default or Profile 1, Profile 2, etc.
CHROME_PROFILE=last_used

# Browser Agent v0.5. Playwright always uses its own profile so it neither
# reads nor modifies the profiles and sessions of your personal Chrome.
BROWSER_PROVIDER=playwright
# JARVIS controls this visible browser with its own local profile. It does not
# attach to, read or alter the user's existing Google Chrome session.
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false
# Motor de búsqueda propio: google, bing, duckduckgo o youtube. También puedes
# decir “busca <tema> en Bing/YouTube” en cada orden.
BROWSER_DEFAULT_SEARCH_ENGINE=google
BROWSER_TIMEOUT=20
BROWSER_PROFILE_DIR=data/browser-profile

# Terminal Agent v0.6. It accepts only structured commands from its allow-list;
# these switches never disable validation, blocked-command policy or confirmations.
TERMINAL_ENABLED=true
TERMINAL_MODE=confirm
TERMINAL_DEFAULT_TIMEOUT=60
TERMINAL_MAX_OUTPUT=12000
TERMINAL_ALLOW_POWERSHELL=true
TERMINAL_ALLOW_CMD=true
TERMINAL_MANAGED_PROCESSES=true

# Code Agent v0.8. ASSIST genera planes/diffs y exige confirmación para aplicar.
# AUTO_FIX permanece limitado a parches deterministas de bajo riesgo; READ_ONLY no edita.
CODE_AGENT_ENABLED=true
CODE_AGENT_MODE=assist
CODE_MAX_FILES=2000
CODE_MAX_FILE_SIZE=1000000
CODE_MAX_TOTAL_BYTES=8000000
CODE_MAX_CONTEXT_TOKENS=2000
CODE_MAX_FIX_ATTEMPTS=3
CODE_PROJECT_SANDBOX=true
CODE_RESPECT_GITIGNORE=true
CODE_AUTO_RUN_TESTS=true
CODE_AUTO_RUN_LINT=true
# Construcción desde prompts: genera un borrador y diff; escribe solo tras
# confirmación explícita. La ruta debe ser una carpeta de trabajo dedicada.
PROJECT_BUILDER_ENABLED=true
PROJECT_BUILDER_ROOT=data/generated-projects
PROJECT_BUILDER_MAX_FILES=20
PROJECT_BUILDER_MAX_FILE_CHARS=40000
VSCODE_INTEGRATION_ENABLED=true

# IoT Agent v0.9. The public broker is only convenient for development;
# production should use a private broker, TLS, authentication and ACLs.
IOT_ENABLED=true
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CLIENT_ID=jarvis-desktop
MQTT_KEEPALIVE=60
MQTT_DEFAULT_QOS=1
MQTT_RECONNECT_ENABLED=true
MQTT_RECONNECT_MAX_SECONDS=30
# Use a per-installation namespace to avoid collisions on development brokers.
MQTT_TOPIC_PREFIX=jarvis/dev-001
MQTT_MAX_PAYLOAD_BYTES=16384
IOT_TELEMETRY_RETENTION_DAYS=30
IOT_COMMAND_TIMEOUT=5
IOT_RULE_COOLDOWN_SECONDS=60
# Leave empty to force an explicit device when more than one ESP32 is registered.
IOT_DEFAULT_DEVICE=
IOT_VERBOSE_TELEMETRY_LOG=false

# JARVIS v1.0. El orquestador solo compone planes con agentes y acciones
# registrados. read_only no abre ni inicia nada; assist solicita confirmación;
# autonomous_safe se limita estrictamente a tareas safe.
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_MODE=assist
ORCHESTRATOR_MAX_RETRIES=2
ORCHESTRATOR_MAX_REPLANS=2
ORCHESTRATOR_MAX_PARALLEL_TASKS=3

# Motor de automatizaciones local y persistente. Las acciones automáticas se
# validan contra la allow-list y solo las de riesgo safe pueden ejecutarse solas.
AUTOMATION_ENGINE_ENABLED=true
AUTOMATION_MAX_ACTIONS=8
AUTOMATION_COOLDOWN_SECONDS=60
AUTOMATION_POLL_SECONDS=20
AUTOMATION_MISFIRE_POLICY=skip

# Alertas de Telegram rápidas y sin bloquear IoT, automatizaciones ni voz.
# Crea un bot con @BotFather y conserva el token exclusivamente en .env.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=3
TELEGRAM_RETRY_ATTEMPTS=1
TELEGRAM_QUEUE_SIZE=250
TELEGRAM_DEDUPLICATION_SECONDS=3

# CyberSeg IDS local. JARVIS solo acepta una API en loopback y las acciones de
# captura requieren confirmación. Usa el mismo token CYBERSEG_ENGINE_TOKEN del
# proyecto CyberSeg; nunca lo guardes en el código.
CYBERSEG_ENABLED=false
CYBERSEG_API_URL=http://127.0.0.1:8780
CYBERSEG_API_TOKEN=
CYBERSEG_TIMEOUT_SECONDS=3
# Las lecturas locales se reintentan con espera exponencial; las acciones de
# iniciar/detener captura no se reenvían para evitar cambios duplicados.
CYBERSEG_HTTP_RETRY_ATTEMPTS=2
CYBERSEG_HTTP_RETRY_BACKOFF_SECONDS=0.35
# Supervisa alertas sin abrir el HUD. En Docker, el compose usa el puente
# host.docker.internal; no expongas CyberSeg directamente a Internet.
CYBERSEG_MONITOR_ENABLED=false
CYBERSEG_MONITOR_POLL_SECONDS=15
# Después de una caída sostenida, el monitor amplía gradualmente la espera
# hasta este límite y vuelve a 15 s en cuanto CyberSeg se recupera.
CYBERSEG_MONITOR_MAX_POLL_SECONDS=120
# Dos reintentos ante fallos transitorios y tres ciclos fallidos antes de
# considerar que CyberSeg está caído. Así una consulta lenta no corta el monitor.
CYBERSEG_MONITOR_RETRY_ATTEMPTS=2
CYBERSEG_MONITOR_FAILURE_THRESHOLD=3
# Telegram recibe interferencias o vulneraciones de esta severidad o superior.
# Las revisiones limpias se envían según el intervalo y los riesgos low/medium
# quedan en el registro local.
CYBERSEG_MONITOR_MIN_RISK=high
# Informa una revisión limpia al iniciar y luego como máximo cada 24 horas.
# No genera avisos de conectividad.
CYBERSEG_MONITOR_CLEAN_REPORT_SECONDS=86400
CYBERSEG_MONITOR_NOTIFY_EXISTING=false
# Mantén las caídas y recuperaciones solo en el registro local para evitar
# mensajes repetidos. Las anomalías nuevas siguen enviándose a Telegram.
CYBERSEG_MONITOR_NOTIFY_SERVICE_STATE=false

# Perfiles CyberSeg: "desktop" solo observa y alerta. "server" ejecuta JARVIS
# sin interfaz gráfica. Para bloquear IPs de alertas HIGH/CRITICAL activa
# explícitamente AUTO_BLOCK y ejecuta el servicio con privilegios de firewall.
CYBERSEG_DEPLOYMENT_PROFILE=desktop
CYBERSEG_SERVER_AUTO_BLOCK=false
CYBERSEG_SERVER_FIREWALL=auto
CYBERSEG_SERVER_MIN_RISK=high
# Nunca bloquees las redes/IP de administración que uses para conectar al servidor.
CYBERSEG_SERVER_ALLOWLIST=
# false evita bloquear por error equipos de la LAN; actívalo solo si la red local
# también debe ser inspeccionada y la lista de permitidos ya está definida.
CYBERSEG_SERVER_ALLOW_PRIVATE_SOURCES=false

# JARVIS v1.1 Visual Control Center. El servidor se liga exclusivamente al
# equipo local y no expone claves, contraseñas ni acciones de shell directas.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_AUTO_OPEN=false
DASHBOARD_WS_ENABLED=true
DASHBOARD_SYSTEM_METRICS_INTERVAL=2
DASHBOARD_TELEMETRY_INTERVAL=2

# Companion móvil: desactivado por defecto. Actívalo solo detrás de HTTPS y
# una red privada/VPN. Genera un token largo y único; se ingresa una vez en la
# app Android y queda cifrado por el almacén de credenciales del dispositivo.
MOBILE_API_ENABLED=false
MOBILE_API_TOKEN=

# JARVIS v1.2 Productivity Agent. Crea las credenciales OAuth en Google Cloud;
# nunca guardes contraseñas de correo ni tokens en este archivo.
PRODUCTIVITY_ENABLED=true
GOOGLE_INTEGRATION_ENABLED=true
GOOGLE_OAUTH_CREDENTIALS_FILE=data/integrations/google-credentials.json
GOOGLE_OAUTH_TOKEN_FILE=data/integrations/google-token.json
PRODUCTIVITY_TIMEZONE=America/Guayaquil
PRODUCTIVITY_WORKDAY_START=08:00
PRODUCTIVITY_WORKDAY_END=20:00
EMAIL_AUTO_SEND=false
EMAIL_IMPORTANT_LIMIT=10
DAILY_AGENDA_ENABLED=false

# JARVIS v1.4 — perfiles locales independientes. Las políticas globales de
# seguridad siempre prevalecen sobre permisos de cada perfil.
USERS_ENABLED=true
USER_AUTH_ENABLED=true
USER_DEFAULT_ROLE=standard
USER_AUTO_LOCK_MINUTES=30
USER_PASSWORD_HASHER=bcrypt
MULTIUSER_MEMORY_ISOLATION=true
MULTIUSER_BROWSER_PROFILE_ISOLATION=true

# Memory Engine 2.0 (v0.7): SQLite local with deterministic local embeddings.
# No memory or embedding is sent to a remote service by this component.
MEMORY_ENABLED=true
MEMORY_MODE=explicit_only
MEMORY_MAX_RESULTS=5
MEMORY_DATABASE=data/jarvis.db
MEMORY_EMBEDDING_PROVIDER=local_hash
MEMORY_CONTEXT_MAX_ITEMS=10
MEMORY_CONTEXT_MAX_TOKENS=600
# Optional encryption is off by default. Activating it also requires a Fernet key
# supplied in MEMORY_ENCRYPTION_KEY; never commit that key.
MEMORY_ENCRYPTION_ENABLED=false
# MEMORY_ENCRYPTION_KEY=
MEMORY_SESSION_RESTORE=false

# Local scheduler and the user's time zone.
SCHEDULER_ENABLED=true
TIMEZONE=America/Guayaquil

# Wake word. The built-in transcript provider is functional with the existing
# microphone/STT setup and can later be replaced by a dedicated acoustic local provider.
WAKE_WORD_ENABLED=true
WAKE_WORD=jarvis
WAKE_WORD_PROVIDER=transcript
WAKE_COMMAND_TIMEOUT=8

# JARVIS Video-Inspired Experience HUD. The overlay/tray remain opt-in because
# desktop integrations require an explicit local GUI environment.
HUD_ENABLED=true
HUD_MODE=hud
HUD_PARTICLES=true
HUD_TARGET_FPS=60
HUD_AUDIO_VISUALIZER=true
HUD_AGENT_GRAPH=true
HUD_SYSTEM_METRICS=true
HUD_AUTO_HIDE_CONVERSATION=true
DESKTOP_OVERLAY_ENABLED=false
SYSTEM_TRAY_ENABLED=false
WAKE_SOUND_ENABLED=true
STARTUP_SOUND_ENABLED=false
